# Local development (see README). Railway sets these as service variables.
DATABASE_URL=postgres://ora@127.0.0.1:5433/ora_dev
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
# Google OAuth client ID (same value the web app uses). Without it Google sign-in answers 503.
GOOGLE_CLIENT_ID=
# Dev only: accept "mock:<id>:<name>" credentials (refused when NODE_ENV=production)
AUTH_MOCK=true
