{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "outDir": "dist", "rootDir": ".", "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["node"], "resolveJsonModule": true
  },
  "include": ["src", "tests", "scripts"]
}
