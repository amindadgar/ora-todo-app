{
	admin off
	auto_https off
	servers {
		# Railway's edge sits in the CGNAT range; trust it so {client_ip} is the real visitor
		trusted_proxies static private_ranges 100.64.0.0/10
		client_ip_headers X-Forwarded-For
	}
}

:{$PORT:8080} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "geolocation=(), camera=(), microphone=(self)"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: https://*.googleusercontent.com; font-src 'self'; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Gateway: /api/* → the api service over Railway's private network (same origin as the app → no CORS, cookies just work)
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy {$API_UPSTREAM:http://127.0.0.1:8081} {
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
		@revalidate path / /index.html /sw.js /registerSW.js /manifest.webmanifest /workbox-*.js
		header @revalidate Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
